## LocalConfig.py.example
## Copy to LocalConfig.py (gitignored) and fill in the real path.
## Python 2.4 has no config-file parsing conveniences worth building, so this is
## just a plain Python module the mod imports directly.

## Root directory state is written under. Each game gets its own subfolder
## (named from the leader and a synthetic game ID persisted in CvGame.scriptData,
## since the engine exposes no readable game ID - see
## AdvisorStateWriter._gameFolderName), containing one file per turn
## (turn_0001.json, turn_0002.json, ...) rather than a single file overwritten
## every turn.
STATE_DIR = r'C:\path\to\civ4-advisor\state'

## Absolute path to this folder (the repo's mod\Assets\Python). Dev convenience
## only - lets the mod re-read AdvisorStateWriter.py from disk on each export, so
## edits apply without restarting the game. Needed because neither __file__ nor
## sys.path resolves to a real location inside the embedded interpreter (both
## verified - see CLAUDE.md). Omit it and the mod still works; you just have to
## restart the game to pick up edits.
MOD_PYTHON_DIR = r'C:\path\to\civ4-advisor\mod\Assets\Python'

## Log how long each export took to Logs\PythonDbg.log (which itself needs
## LoggingEnabled=1 in CivilizationIV.ini - see mod/README.md). Off by default; the
## export runs on the game's critical path and its cost grows with how much map the
## player has revealed, so this is worth turning on periodically rather than once.
## A slow map scan is warned about regardless of this setting.
LOG_TIMINGS = False
